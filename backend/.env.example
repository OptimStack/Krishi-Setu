FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/krishisetu?retryWrites=true&w=majority
MONGODB_DB_NAME=krishisetu
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AUCTION_BATCH_INTERVAL_MINUTES=15
POOLING_MIN_QUANTITY_KG=500
POOLING_MAX_WAIT_MINUTES=60
GRADING_CONFIDENCE_THRESHOLD=0.7
CORS_ALLOWED_ORIGIN=http://localhost:5173
